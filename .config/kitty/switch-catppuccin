#!/bin/sh

set -eu

config_dir="${KITTY_CONFIG_DIRECTORY:-$HOME/.config/kitty}"
nvim_theme="$HOME/.config/nvim/lua/theme-flavour.lua"
current_theme="$config_dir/catppuccin-current.conf"

theme_file() {
    printf '%s/catppuccin/Catppuccin-%s.conf' "$config_dir" "$1"
}

preview_theme() {
    flavour=$1
    kitten @ set-colors --all "$(theme_file "$flavour")" >/dev/null 2>&1 || true
}

if [ "${1:-}" = "--preview" ]; then
    preview_theme "$2"
    exit 0
fi

command -v fzf >/dev/null 2>&1 || {
    printf 'Для переключателя тем нужен fzf.\n' >&2
    exit 1
}

initial=$(sed -n 's/.*Current flavour: \([A-Za-z]*\).*/\1/p' "$current_theme" | head -n 1)
initial=${initial:-Mocha}

choice=$(
    printf '%s\n' Latte Frappe Macchiato Mocha |
        fzf \
            --prompt='Catppuccin › ' \
            --header='↑/↓ предпросмотр  Enter сохранить  Esc отменить' \
            --height=100% \
            --layout=reverse \
            --border=rounded \
            --no-multi \
            --bind="focus:execute-silent($0 --preview {})" \
            --preview='printf "\n  Catppuccin %s\n\n" {}; printf "  \033[30m██\033[31m██\033[32m██\033[33m██\033[34m██\033[35m██\033[36m██\033[37m██\033[0m\n\n  The quick brown fox jumps over the lazy dog\n"' \
            --preview-window='down,45%,border-top'
) || {
    preview_theme "$initial"
    exit 0
}

tmp_theme="${current_theme}.tmp.$$"
tmp_nvim="${nvim_theme}.tmp.$$"
trap 'rm -f "$tmp_theme" "$tmp_nvim"' EXIT HUP INT TERM

{
    printf '# Generated by switch-catppuccin. Current flavour: %s\n' "$choice"
    printf 'include ./catppuccin/Catppuccin-%s.conf\n' "$choice"
} >"$tmp_theme"

lower=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')
{
    printf '%s\n' '-- Обновляется ~/.config/kitty/switch-catppuccin.'
    printf 'return "%s"\n' "$lower"
} >"$tmp_nvim"

mv "$tmp_theme" "$current_theme"
mv "$tmp_nvim" "$nvim_theme"
kitten @ set-colors --all --configured "$(theme_file "$choice")" >/dev/null 2>&1 || true

printf 'Выбрана Catppuccin %s. Neovim применит её при следующем запуске.\n' "$choice"
sleep 1
