function tr(value, number) {
  if (value in t) return t[value]
  if (value ~ /^Switch to workspace [0-9]+$/) { number=value; sub(/^Switch to workspace /,"",number); return "Перейти на рабочее пространство " number }
  if (value ~ /^Move window to workspace [0-9]+$/) { number=value; sub(/^Move window to workspace /,"",number); return "Переместить окно на рабочее пространство " number }
  if (value ~ /^Move window silently to workspace [0-9]+$/) { number=value; sub(/^Move window silently to workspace /,"",number); return "Переместить окно без перехода на пространство " number }
  if (value ~ /^Bar panel [0-9]+$/) { number=value; sub(/^Bar panel /,"",number); return "Панель верхней строки " number }
  if (value ~ /^Switch to group window [0-9]+$/) { number=value; sub(/^Switch to group window /,"",number); return "Перейти на окно группы " number }
  if (value ~ /^Expand window left/) { sub(/^Expand window left/,"Расширить окно влево",value); sub(/ a little$/," немного",value); sub(/ a lot$/," сильно",value); return value }
  if (value ~ /^Shrink window left/) { sub(/^Shrink window left/,"Сжать окно слева",value); sub(/ a little$/," немного",value); sub(/ a lot$/," сильно",value); return value }
  if (value ~ /^Expand window down/) { sub(/^Expand window down/,"Расширить окно вниз",value); sub(/ a little$/," немного",value); sub(/ a lot$/," сильно",value); return value }
  if (value ~ /^Shrink window up/) { sub(/^Shrink window up/,"Сжать окно сверху",value); sub(/ a little$/," немного",value); sub(/ a lot$/," сильно",value); return value }
  return value
}
{
  separator=index($0,"→"); if (!separator) next
  keys=substr($0,1,separator-1); description=substr($0,separator+1)
  sub(/[[:space:]]+$/,"",keys); sub(/^[[:space:]]+/,"",description)
  printf "%-35s → %s\n", keys, tr(description)
}
'
}

if [[ $1 == "--print" ]]; then
  translated_bindings
else
  translated_bindings | omarchy-menu-select 'Горячие клавиши — русская шпаргалка' -- --width 1000 --height 650 >/dev/null
fi
