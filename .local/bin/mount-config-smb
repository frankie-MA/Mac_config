#!/bin/sh

set -eu

mount_point="${SMB_CONFIG_MOUNT_POINT:-/Volumes/homes}"
smb_url="${SMB_CONFIG_URL:-smb://frankie@kateCloud._smb._tcp.local/homes}"

[ "$(uname -s)" = Darwin ] || exit 0

if /sbin/mount | /usr/bin/grep -Fq " on $mount_point (smbfs"; then
    exit 0
fi

/usr/bin/osascript - "$smb_url" <<'APPLESCRIPT'
on run argv
    mount volume (item 1 of argv)
end run
APPLESCRIPT
