#!/bin/sh

set -eu

home_git="${HOME_GIT_DIR:-$HOME/.cfg}"
home_work_tree="${HOME_WORK_TREE:-$HOME}"

detect_smb_remote() {
    if [ -n "${SMB_CONFIG_REMOTE:-}" ]; then
        printf '%s\n' "$SMB_CONFIG_REMOTE"
        return
    fi

    for mount_point in ${SMB_CONFIG_MOUNT_POINT:+"$SMB_CONFIG_MOUNT_POINT"} /Volumes/homes /mnt/katecloud/homes; do
        if mount | grep -Fq " on $mount_point "; then
            printf '%s/repo/git/config.git\n' "$mount_point"
            return
        fi
    done
}

smb_remote="$(detect_smb_remote)"

if [ -z "${SSH_AUTH_SOCK:-}" ]; then
    runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ -S "$runtime_dir/gnupg/S.gpg-agent.ssh" ]; then
        SSH_AUTH_SOCK="$runtime_dir/gnupg/S.gpg-agent.ssh"
        export SSH_AUTH_SOCK
    fi
fi

home() {
    git --git-dir="$home_git" --work-tree="$home_work_tree" "$@"
}

test -d "$home_git" || {
    printf 'missing bare repo: %s\n' "$home_git" >&2
    exit 1
}

home diff --quiet || {
    printf 'refusing to sync: unstaged home changes exist\n' >&2
    home status --short
    exit 1
}

home diff --cached --quiet || {
    printf 'refusing to sync: staged home changes exist\n' >&2
    home status --short
    exit 1
}

home fetch origin main
home merge --ff-only origin/main
home push origin main

if [ -n "$smb_remote" ] && [ -d "$smb_remote" ]; then
    home push "$smb_remote" main
else
    printf 'skip: SMB mirror not mounted or not configured\n'
fi

if command -v config-doctor >/dev/null 2>&1; then
    config-doctor
fi
