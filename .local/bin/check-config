#!/bin/sh

set -eu

repo="${1:-$HOME}"

need() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'missing command: %s\n' "$1" >&2
        exit 1
    }
}

need fish
need nvim
need starship

check_posix_shell() {
    file="$1"
    prefix="$(LC_ALL=C dd if="$file" bs=2 count=1 2>/dev/null)"
    [ "$prefix" = '#!' ] || return 0

    IFS= read -r shebang < "$file" || true
    case "$shebang" in
        '#!/bin/sh'|'#!/usr/bin/sh'|'#!/usr/bin/env sh') sh -n "$file" ;;
    esac
}

for file in "$repo"/.local/bin/*; do
    [ -f "$file" ] || continue
    check_posix_shell "$file"
done

for file in "$repo"/install/*.sh; do
    [ -f "$file" ] || continue
    sh -n "$file"
done

fish -n "$repo/.config/fish/config.fish" "$repo"/.config/fish/conf.d/*.fish
nvim --headless '+qa' >/dev/null 2>&1
starship print-config >/dev/null
"$repo/tests/mount-config-smb.sh"

printf 'ok: config checks passed\n'
